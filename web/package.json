    "axe-core": "^4.14.0",
    "happy-dom": "^20.14.5",
    "oxlint": "^1.0.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^3.2.7",
    "vue-tsc": "^2.1.0"
