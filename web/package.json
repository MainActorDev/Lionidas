    "@codemirror/view": "^6.43.10",
    "@crucible/shared": "workspace:../shared",
    "@lezer/highlight": "^1.2.3",
    "@lucide/vue": "^1.56.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vueuse/core": "^15.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "codemirror": "^6.0.2",
    "jmuxer": "^2.1.4",
    "lucide-vue-next": "^1.0.0",
    "pinia": "^2.2.0",
