{
  "name": "crucible",
  "version": "0.1.0",
  "private": true,
  "description": "Your app. Proven. \u2014 the E2E testing control dashboard.",
  "type": "module",
  "scripts": {
    "check": "pnpm -r check",
    "dev": "concurrently -n server,web -c blue,green \"pnpm --filter server dev\" \"pnpm --filter web dev\"",
    "build": "pnpm -r build",
    "doctor": "bash scripts/setup.sh --check",
    "setup": "bash scripts/setup.sh"
  },
  "devDependencies": {
    "concurrently": "^9.0.0"
  },
  "engines": {
    "node": "24.12.x"
  },
  "pnpm": {
    "neverBuiltDependencies": [],
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ],
    "supportedArchitectures": {
      "os": [
        "darwin"
      ],
      "cpu": [
        "arm64"
      ]
    }
  }
}