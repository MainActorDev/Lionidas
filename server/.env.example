# ── Lionidas server ─────────────────────────────────────────────
# CRUCIBLE_PIN=<set-a-pin>              # operator PIN
# CRUCIBLE_DB_PATH=./crucible.db        # main db (default)
# CRUCIBLE_ARTIFACTS_DIR=./artifacts    # evidence + agent artifacts

# ── Agentic chat (all OPTIONAL — chat falls back to a mock provider
#    that answers honestly 'provider not configured') ────────────
# Provider backend (z.ai GLM coding plan; same key serves both protocols):
# BUTLER_PROVIDER_BASE_URL=https://api.z.ai/api/coding/paas/v4
# BUTLER_API_KEY=<your-zai-key>
# BUTLER_MODEL=glm-5.3-flash
#
# claude-cli middleware (harness) backed by GLM via the anthropic protocol.
# Requires the `claude` CLI installed (npm i -g @anthropic-ai/claude-code):
# BUTLER_PROVIDER=claude-cli
# BUTLER_CLAUDE_BIN=<path-to-claude>    # default: 'claude' on PATH
#
# MCP mount auth: mint a PAT in the UI (Users → api tokens → operator),
# paste it here. The agent's tool calls authenticate as this PAT:
# LIONIDAS_PAT=lion_<token>
